## Usage:
##   make -f Makefile.connect             # status + 3 sample messages per connector
##   make -f Makefile.connect status      # running list only
##   make -f Makefile.connect sample      # samples only
##   make -f Makefile.connect register    # register credentialed connectors only (safe for 6 GB minikube)
##   make -f Makefile.connect register-all # register credentials + all manifest placeholders (needs >6 GB)
##   make -f Makefile.connect deploy      # rebuild JAR + trigger Strimzi Kaniko re-build (~4 min)

CONNECT   ?= http://localhost:18083
BROKER    ?= my-cluster-dual-role-0
NS        ?= kafka
MSGS      ?= 3
CREDS_DIR ?= $(HOME)/.kafka-connect-credentials
MANIFESTS ?= $(dir $(abspath $(lastword $(MAKEFILE_LIST))))src/test/resources/manifests

CODEGEN_DIR ?= $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
JAR_FILE    ?= $(CODEGEN_DIR)build/libs/connect-manifest-codegen-4.4.0-SNAPSHOT.jar
JAR_PORT    ?= 8888
CONNECT_IMG ?= ttl.sh/my-connect-codegen:24h

.PHONY: all status sample register register-all deploy

all: status sample

define PY_STATUS
import json, urllib.request, sys
data = json.loads(urllib.request.urlopen("$(CONNECT)/connectors?expand=status", timeout=10).read())
running = [n for n,i in sorted(data.items()) if (i.get("status",{}).get("tasks") or [{}])[0].get("state") == "RUNNING"]
print("=" * 55)
print(f"  RUNNING: {len(running)}  /  TOTAL: {len(data)}")
print("=" * 55)
[print(f"  OK  {n}") for n in running]
endef
export PY_STATUS

define PY_SAMPLE
import json, subprocess, sys, urllib.request
CONNECT = "$(CONNECT)"; POD = "$(BROKER)"; NS = "$(NS)"; N = $(MSGS)

def api(p):
    return json.loads(urllib.request.urlopen(CONNECT + p, timeout=10).read())

def consume(topic):
    cmd = ["kubectl","exec","-n",NS,POD,"--","bin/kafka-console-consumer.sh",
           "--bootstrap-server","localhost:9092","--topic",topic,
           "--from-beginning","--max-messages",str(N),"--timeout-ms","5000"]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
    return [l for l in r.stdout.splitlines() if l.strip()][:N]

def fmt(s):
    try: s = json.dumps(json.loads(s), ensure_ascii=False, separators=(",",":"))
    except: pass
    return s[:180] + ("…" if len(s) > 180 else "")

data = api("/connectors?expand=status")
running = [n for n,i in sorted(data.items()) if (i.get("status",{}).get("tasks") or [{}])[0].get("state") == "RUNNING"]
print(f"\n{'='*55}")
print(f"  {len(running)} running connectors — {N} messages each")
print(f"{'='*55}\n")
for name in running:
    topics = list(api(f"/connectors/{name}/topics").values())[0].get("topics",[])
    print(f"[ {name} ]")
    if not topics:
        print("  (no topics yet)\n"); continue
    for topic in topics:
        print(f"  topic: {topic}")
        msgs = consume(topic)
        [print(f"  {i+1}. {fmt(m)}") for i,m in enumerate(msgs)] if msgs else print("  (no messages yet)")
    print()
endef
export PY_SAMPLE

define PY_REGISTER
import json, os, re, sys, yaml
import urllib.request, urllib.error
from concurrent.futures import ThreadPoolExecutor, as_completed

CONNECT  = "$(CONNECT)"
CREDS    = "$(CREDS_DIR)"
MANIFESTS= "$(MANIFESTS)"
PKG      = "io.kafka.connect.generated"

def post(name, config):
    body = json.dumps({"name": name, "config": config}).encode()
    req  = urllib.request.Request(f"{CONNECT}/connectors", data=body,
                                   headers={"Content-Type": "application/json"}, method="POST")
    try:
        urllib.request.urlopen(req, timeout=10)
        return name, "created"
    except urllib.error.HTTPError as e:
        if e.code == 409:
            return name, "exists"
        return name, f"ERR {e.code} {e.read().decode()[:80]}"
    except Exception as ex:
        return name, f"ERR {ex}"

# ── 1. Credential files (real creds, highest priority) ──────────────────────
cred_names = set()
tasks = []

if os.path.isdir(CREDS):
    for fname in sorted(os.listdir(CREDS)):
        path = os.path.join(CREDS, fname)
        if fname.endswith(".json"):
            try:
                d = json.load(open(path))
                name   = d.get("name") or fname.replace(".json","")
                config = d.get("config", d)
                config.setdefault("tasks.max", "1")
                config.setdefault("topic.creation.default.replication.factor", "1")
                config.setdefault("topic.creation.default.partitions", "1")
                cred_names.add(name)
                tasks.append((name, config))
            except Exception as ex:
                print(f"  SKIP {fname}: {ex}", file=sys.stderr)
        elif fname.endswith(".properties"):
            try:
                props = {}
                for line in open(path):
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, _, v = line.partition("=")
                        props[k.strip()] = v.strip()
                if "connector.class" not in props:
                    continue
                name = props.pop("name", fname.replace(".properties",""))
                props.pop("topics", None)
                props.setdefault("tasks.max", "1")
                props.setdefault("topic.creation.default.replication.factor", "1")
                props.setdefault("topic.creation.default.partitions", "1")
                cred_names.add(name)
                tasks.append((name, props))
            except Exception as ex:
                print(f"  SKIP {fname}: {ex}", file=sys.stderr)

# ── 2. Register in parallel ─────────────────────────────────────────────────
created = existed = errors = 0
with ThreadPoolExecutor(max_workers=20) as ex:
    futs = {ex.submit(post, n, c): n for n, c in tasks}
    for fut in as_completed(futs):
        name, result = fut.result()
        if result == "created":   created += 1
        elif result == "exists":  existed += 1
        else:
            errors += 1
            print(f"  ERR {name}: {result}", file=sys.stderr)

print(f"Registered: {created}  Already existed: {existed}  Errors: {errors}  Total: {len(tasks)}")
endef
export PY_REGISTER

define PY_REGISTER_ALL
import json, os, re, sys, yaml
import urllib.request, urllib.error
from concurrent.futures import ThreadPoolExecutor, as_completed

CONNECT  = "$(CONNECT)"
CREDS    = "$(CREDS_DIR)"
MANIFESTS= "$(MANIFESTS)"
PKG      = "io.kafka.connect.generated"

def post(name, config):
    body = json.dumps({"name": name, "config": config}).encode()
    req  = urllib.request.Request(f"{CONNECT}/connectors", data=body,
                                   headers={"Content-Type": "application/json"}, method="POST")
    try:
        urllib.request.urlopen(req, timeout=10)
        return name, "created"
    except urllib.error.HTTPError as e:
        if e.code == 409:
            return name, "exists"
        return name, f"ERR {e.code} {e.read().decode()[:80]}"
    except Exception as ex:
        return name, f"ERR {ex}"

cred_names = set()
tasks = []

if os.path.isdir(CREDS):
    for fname in sorted(os.listdir(CREDS)):
        path = os.path.join(CREDS, fname)
        if fname.endswith(".json"):
            try:
                d = json.load(open(path))
                name   = d.get("name") or fname.replace(".json","")
                config = d.get("config", d)
                config.setdefault("tasks.max", "1")
                config.setdefault("topic.creation.default.replication.factor", "1")
                config.setdefault("topic.creation.default.partitions", "1")
                cred_names.add(name)
                tasks.append((name, config))
            except Exception as ex:
                print(f"  SKIP {fname}: {ex}", file=sys.stderr)
        elif fname.endswith(".properties"):
            try:
                props = {}
                for line in open(path):
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, _, v = line.partition("=")
                        props[k.strip()] = v.strip()
                if "connector.class" not in props:
                    continue
                name = props.pop("name", fname.replace(".properties",""))
                props.pop("topics", None)
                props.setdefault("tasks.max", "1")
                props.setdefault("topic.creation.default.replication.factor", "1")
                props.setdefault("topic.creation.default.partitions", "1")
                cred_names.add(name)
                tasks.append((name, props))
            except Exception as ex:
                print(f"  SKIP {fname}: {ex}", file=sys.stderr)

def to_class(fname):
    stem = re.sub(r"^source[-_]", "", os.path.splitext(os.path.basename(fname))[0])
    cls = "".join(w.capitalize() for w in re.split(r"[-_]", stem))
    return "S" + cls if cls and cls[0].isdigit() else cls

def to_name(fname):
    stem = re.sub(r"^source[-_]", "", os.path.splitext(os.path.basename(fname))[0])
    return stem.replace("_", "-")

def placeholder(spec):
    props = {}
    cs = spec.get("spec", {})
    cs = cs.get("connection_specification", cs.get("connectionSpecification", cs)) if cs else spec.get("connection_specification", {})
    for key, defn in cs.get("properties", {}).items():
        t = defn.get("type", "string")
        if isinstance(t, list): t = t[0]
        if t in ("integer", "number"):   props[key] = defn.get("default", 1)
        elif t == "boolean": props[key] = defn.get("default", False)
        elif t == "array":   props[key] = json.dumps(defn.get("examples", defn.get("default", [])) or [])
        elif t == "object":  props[key] = json.dumps(defn.get("default", {}) or {})
        else:
            ev = defn.get("enum", [])
            props[key] = str(ev[0]) if ev else str(defn.get("default", defn.get("examples", [f"placeholder-{key}"])[0] if defn.get("examples") else f"placeholder-{key}"))
    return props

if os.path.isdir(MANIFESTS):
    for fname in sorted(os.listdir(MANIFESTS)):
        if not fname.endswith(".yaml"): continue
        name = to_name(fname)
        if name in cred_names: continue
        try:
            spec   = yaml.safe_load(open(os.path.join(MANIFESTS, fname)))
            config = {"connector.class": f"{PKG}.{to_class(fname)}SourceConnector",
                      "tasks.max": "1",
                      "topic.creation.default.replication.factor": "1",
                      "topic.creation.default.partitions": "1"}
            config.update(placeholder(spec))
            tasks.append((name, config))
        except Exception as ex:
            print(f"  SKIP {fname}: {ex}", file=sys.stderr)

created = existed = errors = 0
with ThreadPoolExecutor(max_workers=20) as ex:
    futs = {ex.submit(post, n, c): n for n, c in tasks}
    for fut in as_completed(futs):
        name, result = fut.result()
        if result == "created":   created += 1
        elif result == "exists":  existed += 1
        else:
            errors += 1
            print(f"  ERR {name}: {result}", file=sys.stderr)

print(f"Registered: {created}  Already existed: {existed}  Errors: {errors}  Total: {len(tasks)}")
endef
export PY_REGISTER_ALL

status:
	@python3 -c "$$PY_STATUS"

sample:
	@python3 -c "$$PY_SAMPLE"

register:
	@python3 -c "$$PY_REGISTER"

register-all:
	@python3 -c "$$PY_REGISTER_ALL"

# ── Strimzi Kaniko re-build ───────────────────────────────────────────────────
# Builds the JAR, serves it on port JAR_PORT, patches the KafkaConnect CR
# with the new SHA512, then waits for Strimzi to complete the Kaniko build
# and roll the Connect pod (~4 minutes total).
deploy:
	@set -e; \
	cd "$(CODEGEN_DIR)/.." && ./gradlew :connect-manifest-codegen:jar -q; \
	pkill -f "http.server $(JAR_PORT)" 2>/dev/null || true; \
	mkdir -p /tmp/jar-serve-$(JAR_PORT); \
	cp "$(JAR_FILE)" /tmp/jar-serve-$(JAR_PORT)/; \
	python3 -m http.server $(JAR_PORT) --directory /tmp/jar-serve-$(JAR_PORT) >/tmp/jar-server.log 2>&1 & \
	sleep 1; \
	SHA=$$(sha512sum "$(JAR_FILE)" | awk '{print $$1}'); \
	HOST_IP=$$(minikube ssh 'ip route show default' 2>/dev/null | awk '/default/{print $$3}'); \
	JAR_NAME=$$(basename "$(JAR_FILE)"); \
	echo "Patching KafkaConnect SHA512: $$SHA"; \
	kubectl patch kafkaconnect my-connect-cluster -n $(NS) --type=json -p="[ \
	  {\"op\":\"replace\",\"path\":\"/spec/build/plugins/0/artifacts/0/sha512sum\",\"value\":\"$$SHA\"}, \
	  {\"op\":\"replace\",\"path\":\"/spec/build/plugins/0/artifacts/0/url\",\"value\":\"http://$$HOST_IP:$(JAR_PORT)/$$JAR_NAME\"} \
	]"; \
	echo "Waiting for Strimzi Kaniko build + pod ready (~4 min)..."; \
	elapsed=0; \
	until kubectl get kafkaconnect my-connect-cluster -n $(NS) -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null | grep -q True; do \
	  sleep 10; elapsed=$$((elapsed+10)); \
	  if [ $$elapsed -ge 600 ]; then echo "TIMEOUT"; exit 1; fi; \
	  echo -n "."; \
	done; \
	echo " done ($$elapsed s)"; \
	pkill -f "http.server $(JAR_PORT)" 2>/dev/null || true
